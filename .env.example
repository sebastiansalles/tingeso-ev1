# Copy this file as .env (next to docker-compose.yml) and fill in the values.
# .env is ignored by Git: it holds the real passwords and must never be committed.

# Docker Hub user that owns the siga-backend and siga-frontend images
DOCKERHUB_USERNAME=your-dockerhub-user

# Host the BROWSER uses to reach the server: localhost on your machine, the public IP in the cloud
PUBLIC_HOST=localhost

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=siga
MYSQL_PASSWORD=change-me

# Keycloak administration console (http://PUBLIC_HOST:9090)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret of the "siga-backend" client (generate one with: openssl rand -hex 32)
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Password of the "admin" user of SIGA
SIGA_ADMIN_PASSWORD=change-me
